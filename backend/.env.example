# NSosyal MÜHÜR — ortam değişkenleri (ÖRNEK). Gerçek .env repoya GİRMEZ.
APP_ENV=development           # development | demo | production
# development'ta secret yoksa dev anahtarı kullanılır (uyarıyla).
# demo/production'da AŞAĞIDAKİLER ZORUNLU, yoksa servis başlamaz (fail-closed):
MUHUR_POP_SECRET=change-me-strong-pop-secret
MUHUR_POA_SECRET=change-me-strong-poa-secret   # POP'tan FARKLI olmalı
PERSONHOOD_TTL_SECONDS=3600
CHECKIN_CHALLENGE_TTL_SECONDS=90
# ALLOW_INSECURE_DEV_KEYS=true   # yalnız development için
