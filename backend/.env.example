# NSosyal MÜHÜR — ortam değişkenleri (ÖRNEK). Gerçek .env repoya GİRMEZ.
APP_ENV=development           # development | demo | production

# development'ta aşağıdakiler boşsa backend/.dev_keys/ altında bir kez üretilir.
# demo/production'da ZORUNLU, yoksa servis başlamaz (fail-closed).
# Ed25519 anahtar üretmek için:
#   python -c "from app.security.keys import generate_private_pem as g; print(g())"
MUHUR_POP_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
MUHUR_POA_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"   # PoP'tan FARKLI
MUHUR_PSEUDONYM_SECRET=change-me-uzun-rastgele-deger

MUHUR_DB_PATH=muhur.db
MUHUR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # demo/prod'da '*' yasak
MUHUR_DEMO_ORGANIZER_KEY=change-me-organizator-anahtari          # development'ta varsayılan: demo-kulup-anahtari
MUHUR_ENABLE_DEMO_ENDPOINTS=false                                # /demo/* simülasyon uçları
MUHUR_RATE_LIMIT_PER_MIN=60

PERSONHOOD_TTL_SECONDS=3600
CHECKIN_CHALLENGE_TTL_SECONDS=90
ATTENDANCE_TTL_SECONDS=15552000
